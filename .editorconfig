root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,js,css,html,json,yml,yaml,ini,sh}]
indent_style = space
indent_size = 2

[*.{c,cc,cpp,h,hpp,ino}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
